{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavcse.local/schemas/literature-catalog-entry-v1.json",
  "title": "wavCSE literature paper identity",
  "description": "Identity and canonical-card resolution only; Study-specific screening state is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "card_path",
    "title",
    "year",
    "authors",
    "venue",
    "external_ids",
    "source_urls",
    "aliases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "card_path": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$"
          }
        },
        "arxiv": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{4,5}(?:v\\d+)?$"
          }
        }
      }
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
